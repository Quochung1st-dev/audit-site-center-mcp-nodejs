# URL gốc của API AuditSite Center (Laravel backend)
AUDIT_SITE_API_URL=http://localhost:8000

# Token xác thực gọi API (Bearer token hoặc token MCP tương ứng)
AUDIT_SITE_API_TOKEN=

# Tên server MCP hiển thị cho client
MCP_SERVER_NAME=audit-site-center

# Mức log: debug | info | warn | error
LOG_LEVEL=info
